{
  "builds": [
    {"src": "api/index.py", "use": "@vercel/python", "config": {"includeFiles": ["templates/**"]}},
    {"src": "static/**", "use": "@vercel/static"}
  ],
  "routes": [
    {"src": "/static/(.*)", "dest": "/static/$1", "headers": {"cache-control": "public, max-age=86400, immutable"}},
    {"src": "/(.*)", "dest": "api/index.py"}
  ]
}
